.env

# Credenciais do Superadmin local geradas pelo seed (nunca versionar)
ADMIN_CREDENTIALS.txt

# Diretório local do opencode (planos/plugins) — não versionar
.opencode/

# Lixo do macOS (evita arquivos tipo "._arquivo")
._*
.DS_Store

# Dados live por servidor (runtime)
live/

# Configs geradas por `scripts/servers.sh init` (server.cfg contém rcon_password)
config/servers/

# Backup do banco com dados reais (contém IPs de jogadores) — não versionar
csstats_backup.sql

# Backup de config/servers.list gerado por scripts/setup.sh
config/servers.list.bak

# Stack TLS/DDNS (duckdns/): config do swag (certs, nginx, fail2ban), backups
# de certs e .env local. Versionados: docker-compose.duckdns.yml (raiz),
# duckdns/backup.sh e duckdns/init-certbot-config.run (patch do certcheck).
duckdns/.env
duckdns/backups/
duckdns/swag/

# Estado dos upgrades da API (imagens rollback-<ts> + HEAD por fase)
.rollback-state

# node_modules local (host não tem Node; gerado só dentro de containers)
api/node_modules/

# valve.zip (assets proprietários do Half-Life) — não versionar; o código do
# bridge WebRTC vive no submodule watch/webxash3d-proxy (fork privado).
valve/

# Binários baixados do stack UAC (ReHLDS/ReGameDLL/Metamod-R/ReUnion/AMXX/UAC)
# pinados por versão — baixados em cs16/vendor/ durante a homologação.
cs16/vendor/
# Plugins por modo (exceção — devem ser versionados)
!cs16/vendor/mode_plugins/
!cs16/vendor/mode_plugins/**
watch/webxash3d-proxy/dist/
watch/webxash3d-proxy/target/
watch/webxash3d-proxy/client/node_modules/
*.bak
