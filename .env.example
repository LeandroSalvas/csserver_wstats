## Copy this file to ".env" and set strong values.
## Never commit your real ".env".

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=csstats
MYSQL_USER=csuser
MYSQL_PASSWORD=change_me_user

# --- Docker Compose ---
# Faz `docker compose <cmd>` usar o override gerado por scripts/servers.sh compose
# (docker-compose.servers.yml) junto com o base, sem precisar de -f. O override é
# regenerado por scripts/servers.sh compose, scripts/servers.sh up ou scripts/setup.sh.
COMPOSE_FILE=docker-compose.yml:docker-compose.servers.yml

# --- API ---
# If omitted, compose defaults DB_HOST to "db"
DB_HOST=db
SESSION_SECRET=change_me_to_a_long_random_string

# Comma-separated exact origins allowed to call the API with credentials.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:8080,http://192.168.15.54:8080
# If omitted, the API falls back to allowing: http://localhost:8080,http://192.168.15.54:8080.
CORS_ALLOWED_ORIGINS=

# --- Game Server Connection ---
GAMEDIG_HOST=cs16
GAMEDIG_PORT=27015

# --- Multi-server monitoring (optional) ---
# JSON array overriding GAMEDIG_HOST/GAMEDIG_PORT. The first entry is the primary
# server (used by snapshots/rankings and RCON). Each entry may set an optional
# liveDir (inside the api container) where the AMX plugin writes its JSON files.
# Normally this is generated by scripts/servers.sh compose (see config/servers.list).
# CS_SERVERS=[{"id":"main","name":"Zueira","host":"cs16","port":27015,"liveDir":"/live_data/main"}]

# --- Alerts (optional) ---
# Webhook URL (Slack/Teams/Generic or Discord) notified on server online/offline changes.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# --- Steam login (optional) ---
# Public HTTPS URL of the web frontend where Steam will redirect after login.
# STEAM_RETURN_URL=https://zueiracstrike.duckdns.org:8443/api/auth/steam/callback
# Comma-separated SteamID64s allowed to log in as admin.
# STEAM_ADMIN_IDS=76561198000000000

# --- Live data files ---
# Directory (inside the api container) with live_scoreboard.json / live_killfeed.json
# written by the AMX Mod X plugin. Default matches the cs16_stats image.
# LIVE_DATA_DIR=/home/cs16/cstrike/addons/amxmodx/data/live

# --- Game Server ---
# Must match the rcon_password generated in config/servers/<id>/server.cfg
RCON_PASSWORD=change_me_rcon_password

# --- Session store (Redis) ---
# Use "redis" (recommended) or "memory"
SESSION_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Espectador web (WebRTC) — opt-in (scripts/watch.sh up) ---
# IP público para os ICE candidates do WebRTC (anunciado ao browser).
# WATCH_PUBLIC_IP=191.11.221.158
# Porta do proxy (página do espectador + signaling WebSocket).
# WATCH_LISTEN_PORT=27018
# Faixa de portas UDP fixas para o ICE (abrir no firewall/NAT).
# WATCH_UDP_PORT_RANGE=27019-27050
# Porta do relay HLTV.
# WATCH_HLTV_PORT=27020
# Comandos de console executados no cliente espectador (câmera automática).
# WATCH_CONSOLE_COMMANDS=spec_autodirector 1
# Caminho do valve.zip dentro do container (assets do Half-Life).
# WATCH_PACKAGE_ZIP=/valve/valve.zip
