## Copy this file to ".env" and set strong values.
## Never commit your real ".env".

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=csstats
MYSQL_USER=csuser
MYSQL_PASSWORD=change_me_user

# --- Docker Compose ---
# Faz `docker compose <cmd>` usar o override gerado por scripts/servers.sh compose
# (docker-compose.servers.yml) e a stack TLS/DDNS (docker-compose.duckdns.yml:
# swag + duckdns), sem precisar de -f. O override é regenerado por
# scripts/servers.sh compose, scripts/servers.sh up ou scripts/setup.sh.
COMPOSE_FILE=docker-compose.yml:docker-compose.servers.yml:docker-compose.duckdns.yml

# --- TLS/DDNS (swag & duckdns) — obrigatório para o swag/duckdns subirem ---
# Token do DuckDNS para o subdomínio zueiracstrike (https://duckdns.org).
# Sem ele o swag não valida o cert e o duckdns não atualiza o IP público.
# DUCKDNS_TOKEN=

# --- API ---
# If omitted, compose defaults DB_HOST to "db"
DB_HOST=db
SESSION_SECRET=change_me_to_a_long_random_string
# Opcional: força cookie de sessão Secure (true) mesmo sem NODE_ENV=production.
# Padrão: NODE_ENV == "production".
# SESSION_COOKIE_SECURE=true

# Comma-separated exact origins allowed to call the API with credentials.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:8080,http://192.168.15.54:8080
# If omitted, the API falls back to allowing: http://localhost:8080,http://192.168.15.54:8080.
CORS_ALLOWED_ORIGINS=

# --- Game Server Connection ---
GAMEDIG_HOST=cs16
GAMEDIG_PORT=27015

# --- Multi-server monitoring (optional) ---
# A lista de servidores vive em config/servers.list (fonte da verdade); o API a
# lê em runtime (api/lib/serverCtx.js, poll 5s), sem rebuild. Cada entrada:
# id name host_port map maxplayers rotate context. A primeira é o primary
# (snapshots/rankings e RCON default).
# Fallback (apenas se o servers.list não existir no container):
# CS_SERVERS=[{"id":"main","name":"Zueira","host":"cs16","port":27015,"liveDir":"/repo/live/main"}]

# --- Alerts (optional) ---
# Webhook URL (Discord, Slack/Teams/Generic) notificado em: online/offline de
# servidores de jogo, indisponibilidade de serviços da stack e aprovação de
# novos admins (pendente/aprovado/rejeitado). Para o Discord, crie um webhook
# incoming apontando para o canal desejado (Server Settings → Integrations →
# Webhooks) e cole a URL aqui.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- Discord bot (optional) ---
# Bot que gerencia a stack por comandos de texto (prefixo '!') no Discord:
#   !status, !servidores, !stack, !start/!stop/!restart <id>, !rcon <id> <cmd>.
# Crie um application em https://discord.com/developers → Bot → copie o token e
# ative o intent privilegiado MESSAGE CONTENT. Convide o bot ao servidor.
# Permissão: somente membros com role em DISCORD_ALLOWED_ROLE_IDS ou ID em
# DISCORD_ALLOWED_USER_IDS (listas separadas por vírgula). Sem token ou sem
# permissões configuradas o bot é desabilitado (sem crash).
# DISCORD_BOT_TOKEN=seu_token_aqui
# DISCORD_ALLOWED_ROLE_IDS=
# DISCORD_ALLOWED_USER_IDS=

# --- Steam login (optional) ---
# Public HTTPS URL of the web frontend where Steam will redirect after login.
# STEAM_RETURN_URL=https://zueiracstrike.duckdns.org:4443/api/auth/steam/callback
# Obs.: desde o novo fluxo de aprovação, TODO primeiro login social (Steam/Google)
# entra como "pending" e precisa ser aprovado pelo superadmin local na página
# /usuarios. STEAM_ADMIN_IDS deixou de ser usado como lista de pré-aprovados.

# --- Google login (optional) ---
# OAuth2 credentials criadas em https://console.cloud.google.com/apis/credentials
# (authorized redirect URI = GOOGLE_RETURN_URL).
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
# GOOGLE_RETURN_URL=https://zueiracstrike.duckdns.org:4443/api/auth/google/callback

# --- Auth / superadmin local ---
# Seed do Superadmin local no boot (gera ADMIN_CREDENTIALS.txt no repo, gitignored).
# SEED_ADMIN=1
# ADMIN_USERNAME=admin

# --- Server management (admin page /servidores) ---
# O container api controla os containers via socket docker + repo montado em
# SERVER_REPO_DIR. Add/remove roda scripts/servers.sh num container descartável
# da imagem SERVER_MANAGER_IMAGE.
# SERVER_MANAGER_PROVIDER=docker
# SERVER_REPO_DIR=/repo
# SERVER_MANAGER_IMAGE=csserver_wstats-api
# SERVER_MANAGER_TIMEOUT_MS=240000

# --- Live data files ---
# Directory (inside the api container) with live_scoreboard.json / live_killfeed.json
# written by the AMX Mod X plugin. Default matches the cs16_stats image.
# LIVE_DATA_DIR=/home/cs16/cstrike/addons/amxmodx/data/live

# --- Game Server ---
# Must match the rcon_password generated in config/servers/<id>/server.cfg
RCON_PASSWORD=change_me_rcon_password

# --- Session store (Redis) ---
# Use "redis" (recommended) or "memory"
SESSION_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Métricas Prometheus (Basic Auth) ---
# Credenciais exigidas pelo /api/metrics e pelo scrape do Prometheus.
# O config/prometheus.yml é um template com __METRICS_USER__/__METRICS_PASS__
# (o Prometheus não expande variáveis no --config.file; o compose o gera por sed).
# IMPORTANTE: use APENAS caracteres alfanuméricos (sem / & \ ) para não quebrar o sed.
# Se deixadas vazias, o /metrics fica sem autenticação (com aviso no log da API).
METRICS_USER=
METRICS_PASS=

# --- Espectador web (WebRTC) — opt-in (scripts/watch.sh up) ---
# Um par watch-main/watch-hltv por servidor de servers.list. As portas são
# derivadas por índice na lista (i = posição em config/servers.list):
#   relay HLTV UDP       WATCH_HLTV_BASE+i
#   listen TCP watch-main WATCH_LISTEN_BASE+i
#   WebRTC ICE UDP       WATCH_UDP_BASE+(i*WATCH_UDP_SIZE)..(+WATCH_UDP_SIZE-1)
# O IP público NÃO é configurado: o proxy descobre via STUN (stun.l.google.com)
# em cada conexão (srflx), sem valor hardcoded.
# WATCH_HLTV_BASE=27100
# WATCH_LISTEN_BASE=27200
# WATCH_UDP_BASE=27300
# WATCH_UDP_SIZE=64
# Comandos de console executados no cliente espectador (câmera automática).
# WATCH_CONSOLE_COMMANDS=spec_autodirector 1
# Caminho do valve.zip dentro do container (assets do Half-Life).
# WATCH_PACKAGE_ZIP=/valve/valve.zip
# URL pública base do espectador (swag). A API gera spectatorUrl = BASE/<context>/
# para cada servidor (context = 7ª coluna de config/servers.list).
# WATCH_PUBLIC_BASE=https://zueiracstrike.duckdns.org:4445
# Host que o swag usa para alcançar o watch-main (network_mode: host).
# WATCH_UPSTREAM_HOST=192.168.15.54

# --- Docker Hub (scripts/push-images.sh) ---
# Usuário do Docker Hub para as imagens csserver_wstats-cs16/-api/-watch-main.
# DOCKER_USER=myuser
